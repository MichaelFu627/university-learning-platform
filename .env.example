# Copy to .env.local. No keys are needed for local files, schedules or excerpt search.
DATA_DIR=./data
APP_TIMEZONE=Australia/Melbourne

# Any trusted provider implementing the OpenAI-compatible chat/completions API.
# Course excerpts are sent to this provider only when using AI features.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Optional semantic retrieval. Changing this model requires reindexing documents.
EMBEDDING_MODEL=
AI_DAILY_LIMIT=100

# Optional PDF conversion for PPT/PPTX/DOCX. macOS Homebrew example:
SOFFICE_PATH=/opt/homebrew/bin/soffice

# Optional email reminders. Otherwise reminders stay in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REMINDER_EMAIL=
