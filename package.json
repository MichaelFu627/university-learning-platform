{
  "name": "university-learning-platform",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -k -n web,worker \"next dev --hostname 127.0.0.1\" \"tsx watch scripts/worker.ts\"",
    "build": "next build",
    "start": "concurrently -k -n web,worker \"next start --hostname 127.0.0.1\" \"tsx scripts/worker.ts\"",
    "worker": "tsx scripts/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "concurrently": "^9.2.1",
    "dotenv": "^17.3.1",
    "fast-xml-parser": "^5.5.0",
    "lucide-react": "^0.577.0",
    "luxon": "^3.7.2",
    "next": "^16.2.0",
    "nodemailer": "10.0.13",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/adm-zip": "^0.5.7",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.3"
  }
}
